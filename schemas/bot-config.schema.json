{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "BotConfig",
  "description": "V2 Bot configuration - the full config format for all strategies.\n\nThis is the **schema-generation** version of BotConfig. It uses flat `MarketConfig` structs (for clean JSON Schema output), unlike the engine's `BotConfig` which uses typed `bot_core::Market` enums for runtime parsing.",
  "type": "object",
  "required": [
    "address",
    "environment",
    "private_key",
    "strategy_type"
  ],
  "properties": {
    "address": {
      "description": "Wallet address",
      "type": "string"
    },
    "arbitrage": {
      "description": "Arbitrage strategy configuration",
      "default": null,
      "anyOf": [
        {
          "$ref": "#/definitions/ArbitrageConfigJson"
        },
        {
          "type": "null"
        }
      ]
    },
    "base_url_override": {
      "description": "Optional Hyperliquid base URL override. When set, both /info and /exchange requests use this gateway.",
      "default": null,
      "type": [
        "string",
        "null"
      ]
    },
    "builder_fee": {
      "description": "Builder fee configuration",
      "default": null,
      "anyOf": [
        {
          "$ref": "#/definitions/BuilderFeeConfig"
        },
        {
          "type": "null"
        }
      ]
    },
    "dca": {
      "description": "DCA strategy configuration",
      "default": null,
      "anyOf": [
        {
          "$ref": "#/definitions/DCAConfigJson"
        },
        {
          "type": "null"
        }
      ]
    },
    "environment": {
      "description": "Environment: \"testnet\" or \"mainnet\"",
      "type": "string"
    },
    "grid": {
      "description": "Grid strategy configuration",
      "default": null,
      "anyOf": [
        {
          "$ref": "#/definitions/GridConfigJson"
        },
        {
          "type": "null"
        }
      ]
    },
    "hip3": {
      "description": "HIP-3 configuration",
      "default": null,
      "anyOf": [
        {
          "$ref": "#/definitions/Hip3ConfigJson"
        },
        {
          "type": "null"
        }
      ]
    },
    "markets": {
      "description": "Markets to trade on (V2 format)",
      "default": [],
      "type": "array",
      "items": {
        "$ref": "#/definitions/MarketConfig"
      }
    },
    "mm": {
      "description": "Market Maker strategy configuration",
      "default": null,
      "anyOf": [
        {
          "$ref": "#/definitions/MMConfigJson"
        },
        {
          "type": "null"
        }
      ]
    },
    "orchestrator": {
      "description": "Orchestrator strategy configuration",
      "default": null,
      "anyOf": [
        {
          "$ref": "#/definitions/OrchestratorConfigJson"
        },
        {
          "type": "null"
        }
      ]
    },
    "outcome_expiry": {
      "description": "Optional explicit outcome expiry override.\n\nUsed only when Hyperliquid outcome metadata does not expose a machine-readable expiry. Accepted by the bot as RFC3339, HL compact `YYYYMMDD-HHMM`, or epoch ms.",
      "default": null,
      "type": [
        "string",
        "null"
      ]
    },
    "poll_delay_ms": {
      "description": "Polling delay in milliseconds",
      "default": 500,
      "type": "integer",
      "format": "uint64",
      "minimum": 0.0
    },
    "private_key": {
      "description": "Private key (hex, with or without 0x prefix)",
      "type": "string"
    },
    "strategy_type": {
      "description": "Strategy type: \"grid\", \"mm\", \"dca\", \"arbitrage\", or \"orchestrator\"",
      "type": "string"
    },
    "sync": {
      "description": "Trade sync configuration",
      "default": null,
      "anyOf": [
        {
          "$ref": "#/definitions/SyncConfigJson"
        },
        {
          "type": "null"
        }
      ]
    },
    "vault_address": {
      "description": "Optional vault address",
      "default": null,
      "type": [
        "string",
        "null"
      ]
    }
  },
  "definitions": {
    "ArbitrageConfigJson": {
      "description": "Arbitrage strategy configuration from JSON",
      "type": "object",
      "required": [
        "min_closing_spread_pct",
        "min_opening_spread_pct",
        "order_amount",
        "perp_leverage"
      ],
      "properties": {
        "min_closing_spread_pct": {
          "description": "Minimum spread to close (e.g., \"-0.001\" = -0.1%)",
          "type": "string"
        },
        "min_opening_spread_pct": {
          "description": "Minimum spread to open (e.g., \"0.003\" = 0.3%)",
          "type": "string"
        },
        "order_amount": {
          "description": "Order amount in quote asset / USDC (e.g., \"100\" = $100 worth)",
          "type": "string"
        },
        "perp_leverage": {
          "description": "Leverage for perp position",
          "type": "string"
        },
        "perp_slippage_buffer_pct": {
          "description": "Slippage buffer for perp orders",
          "default": "0.001",
          "type": "string"
        },
        "spot_slippage_buffer_pct": {
          "description": "Slippage buffer for spot orders",
          "default": "0.001",
          "type": "string"
        }
      }
    },
    "BuilderFeeConfig": {
      "description": "Builder fee configuration for JSON config",
      "type": "object",
      "required": [
        "address",
        "fee_tenths_bp"
      ],
      "properties": {
        "address": {
          "description": "Builder address to receive the fee",
          "type": "string"
        },
        "fee_tenths_bp": {
          "description": "Fee in tenths of a basis point (e.g., 30 = 3 bp = 0.03%)",
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        }
      }
    },
    "DCAConfigJson": {
      "description": "DCA strategy configuration from JSON",
      "type": "object",
      "required": [
        "base_order_size",
        "dca_order_size",
        "price_deviation_pct",
        "take_profit_pct",
        "trigger_price"
      ],
      "properties": {
        "base_order_size": {
          "description": "Base order size in base asset",
          "type": "string"
        },
        "cooldown_period_secs": {
          "description": "Cooldown period in seconds between cycles (default: 60)",
          "default": 60,
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "dca_order_size": {
          "description": "DCA order size in base asset",
          "type": "string"
        },
        "deviation_multiplier": {
          "description": "Deviation multiplier for subsequent triggers",
          "default": "1.0",
          "type": "string"
        },
        "direction": {
          "description": "Direction: \"long\" or \"short\"",
          "default": "long",
          "type": "string"
        },
        "leverage": {
          "description": "Leverage (1 for spot-like)",
          "default": "5",
          "type": "string"
        },
        "max_dca_orders": {
          "description": "Maximum number of DCA orders",
          "default": 5,
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        },
        "max_leverage": {
          "description": "Max leverage allowed",
          "default": "50",
          "type": "string"
        },
        "price_deviation_pct": {
          "description": "Price deviation percentage to trigger first DCA",
          "type": "string"
        },
        "restart_on_complete": {
          "description": "Whether to restart cycle after take profit",
          "default": false,
          "type": "boolean"
        },
        "size_multiplier": {
          "description": "Size multiplier for each subsequent DCA order",
          "default": "2.0",
          "type": "string"
        },
        "stop_loss": {
          "description": "Optional stop loss as absolute PnL threshold (negative value)",
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "take_profit_pct": {
          "description": "Take profit percentage from average entry",
          "type": "string"
        },
        "trigger_price": {
          "description": "Price to trigger base order",
          "type": "string"
        }
      }
    },
    "GridConfigJson": {
      "description": "Grid strategy configuration from JSON",
      "type": "object",
      "required": [
        "end_price",
        "max_investment_quote",
        "start_price"
      ],
      "properties": {
        "end_price": {
          "description": "End price of the grid",
          "type": "string"
        },
        "levels": {
          "description": "Number of grid levels",
          "default": 20,
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        },
        "leverage": {
          "description": "Leverage to use",
          "default": "5",
          "type": "string"
        },
        "max_investment_quote": {
          "description": "Maximum investment in quote currency (USDC)",
          "type": "string"
        },
        "max_leverage": {
          "description": "Maximum leverage allowed (for liquidation calculation)",
          "default": "50",
          "type": "string"
        },
        "mode": {
          "description": "Grid mode: \"long\", \"short\", \"neutral\"",
          "default": "long",
          "type": "string"
        },
        "post_only": {
          "description": "Use post-only orders",
          "default": false,
          "type": "boolean"
        },
        "start_price": {
          "description": "Start price of the grid",
          "type": "string"
        },
        "stop_loss": {
          "description": "Stop loss (optional)",
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "take_profit": {
          "description": "Take profit (optional)",
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "trailing_down_limit": {
          "description": "Trailing lower limit price (optional). When set, enables trailing-down: the grid slides down as price falls, until the bottom of the window would go below this floor.",
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "trailing_up_limit": {
          "description": "Trailing upper limit price (optional). When set, enables trailing-up: the grid slides up as price rises, until the top of the window would exceed this ceiling.",
          "default": null,
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "Hip3ConfigJson": {
      "description": "HIP-3 configuration",
      "type": "object",
      "required": [
        "dex_index",
        "dex_name"
      ],
      "properties": {
        "asset_index": {
          "description": "Asset index within the DEX",
          "default": 0,
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        },
        "dex_index": {
          "description": "The index of the DEX",
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        },
        "dex_name": {
          "description": "The HIP-3 DEX name",
          "type": "string"
        },
        "quote_currency": {
          "description": "Quote currency: \"USDC\" or \"USDH\"",
          "default": "USDC",
          "type": "string"
        }
      }
    },
    "InstrumentMetaConfig": {
      "description": "Instrument metadata configuration",
      "type": "object",
      "required": [
        "lot_size",
        "tick_size"
      ],
      "properties": {
        "lot_size": {
          "description": "Lot size (quantity precision)",
          "type": "string"
        },
        "min_notional": {
          "description": "Minimum notional value",
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "min_qty": {
          "description": "Minimum order quantity",
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "tick_size": {
          "description": "Tick size (price precision)",
          "type": "string"
        }
      }
    },
    "InstrumentMetaConfig2": {
      "description": "Configuration for instrument metadata (tick/lot sizes).",
      "type": "object",
      "required": [
        "lot_size",
        "tick_size"
      ],
      "properties": {
        "lot_size": {
          "description": "Lot size for quantity rounding",
          "type": "string",
          "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
        },
        "min_notional": {
          "description": "Minimum notional value",
          "default": null,
          "type": [
            "string",
            "null"
          ],
          "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
        },
        "min_qty": {
          "description": "Minimum quantity",
          "default": null,
          "type": [
            "string",
            "null"
          ],
          "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
        },
        "tick_size": {
          "description": "Tick size for price rounding",
          "type": "string",
          "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
        }
      }
    },
    "MMConfigJson": {
      "description": "Market Maker strategy configuration",
      "type": "object",
      "required": [
        "base_order_size",
        "base_spread",
        "max_position_size"
      ],
      "properties": {
        "base_order_size": {
          "description": "Base order size in base asset",
          "type": "string"
        },
        "base_spread": {
          "description": "Base spread between bid and ask",
          "type": "string"
        },
        "max_position_size": {
          "description": "Maximum position size in base asset",
          "type": "string"
        },
        "min_price_change_pct": {
          "description": "Minimum price change to update quotes",
          "default": "0.0005",
          "type": "string"
        },
        "price_skew_gamma": {
          "description": "Price skew gamma (how aggressively to skew quotes based on position)",
          "default": "0.05",
          "type": "string"
        },
        "size_skew_floor": {
          "description": "Size skew floor (minimum size for quotes)",
          "default": "0.2",
          "type": "string"
        },
        "skew_mode": {
          "description": "Skew mode: \"both\", \"size\", \"price\", or \"none\"",
          "default": "both",
          "type": "string"
        },
        "stop_loss": {
          "description": "Stop loss (optional)",
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "take_profit": {
          "description": "Take profit (optional)",
          "default": null,
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "Market": {
      "description": "Unified market configuration — replaces scattered config fields.\n\nThis is the canonical representation of \"where to trade\". All exchange/market-type-specific details are encapsulated here.",
      "oneOf": [
        {
          "description": "Hyperliquid exchange markets",
          "type": "object",
          "oneOf": [
            {
              "description": "Standard perpetual contract on main Hyperliquid.",
              "type": "object",
              "required": [
                "base",
                "index",
                "type"
              ],
              "properties": {
                "base": {
                  "description": "Base asset (e.g., \"BTC\", \"ETH\")",
                  "type": "string"
                },
                "index": {
                  "description": "Asset index on Hyperliquid (e.g., 0 for BTC)",
                  "type": "integer",
                  "format": "uint32",
                  "minimum": 0.0
                },
                "instrument_meta": {
                  "description": "Instrument metadata (tick/lot sizes)",
                  "default": null,
                  "anyOf": [
                    {
                      "$ref": "#/definitions/InstrumentMetaConfig2"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "quote": {
                  "description": "Quote asset (always \"USDC\" for main perps)",
                  "default": "USDC",
                  "type": "string"
                },
                "type": {
                  "type": "string",
                  "enum": [
                    "perp"
                  ]
                }
              }
            },
            {
              "description": "Spot market on Hyperliquid.",
              "type": "object",
              "required": [
                "base",
                "index",
                "type"
              ],
              "properties": {
                "base": {
                  "description": "Base asset (e.g., \"HYPE\", \"PURR\")",
                  "type": "string"
                },
                "index": {
                  "description": "Spot market index (e.g., 10107 for HYPE/USDC)",
                  "type": "integer",
                  "format": "uint32",
                  "minimum": 0.0
                },
                "instrument_meta": {
                  "description": "Instrument metadata (tick/lot sizes)",
                  "default": null,
                  "anyOf": [
                    {
                      "$ref": "#/definitions/InstrumentMetaConfig2"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "quote": {
                  "description": "Quote asset (e.g., \"USDC\")",
                  "default": "USDC",
                  "type": "string"
                },
                "type": {
                  "type": "string",
                  "enum": [
                    "spot"
                  ]
                }
              }
            },
            {
              "description": "HIP-3 builder-deployed perpetual DEX.",
              "type": "object",
              "required": [
                "asset_index",
                "base",
                "dex",
                "dex_index",
                "quote",
                "type"
              ],
              "properties": {
                "asset_index": {
                  "description": "Asset index within this DEX's meta.universe",
                  "type": "integer",
                  "format": "uint32",
                  "minimum": 0.0
                },
                "base": {
                  "description": "Base asset (e.g., \"BTC\", \"HFUN\")",
                  "type": "string"
                },
                "dex": {
                  "description": "DEX name (e.g., \"hyna\", \"hypurrfun\")",
                  "type": "string"
                },
                "dex_index": {
                  "description": "DEX index in perpDexs() array (starts at 1)",
                  "type": "integer",
                  "format": "uint32",
                  "minimum": 0.0
                },
                "instrument_meta": {
                  "description": "Instrument metadata (tick/lot sizes)",
                  "default": null,
                  "anyOf": [
                    {
                      "$ref": "#/definitions/InstrumentMetaConfig2"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "quote": {
                  "description": "Quote currency (e.g., \"USDC\", \"USDE\", \"USDH\")",
                  "type": "string"
                },
                "type": {
                  "type": "string",
                  "enum": [
                    "hip3"
                  ]
                }
              }
            },
            {
              "description": "Prediction market outcome.\n\nOutcomes trade like spot but use asset ID = 100_000_000 + encoding, where encoding = 10 * outcome_id + side. Live outcome books quote in USDH.",
              "type": "object",
              "required": [
                "name",
                "outcome_id",
                "side",
                "type"
              ],
              "properties": {
                "instrument_meta": {
                  "description": "Instrument metadata (tick/lot sizes)",
                  "default": null,
                  "anyOf": [
                    {
                      "$ref": "#/definitions/InstrumentMetaConfig2"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "name": {
                  "description": "Human-readable name (e.g., \"BTC > 69070\")",
                  "type": "string"
                },
                "outcome_id": {
                  "description": "Outcome ID from outcomeMeta (e.g., 516)",
                  "type": "integer",
                  "format": "uint32",
                  "minimum": 0.0
                },
                "side": {
                  "description": "Side: 0 = Yes, 1 = No",
                  "type": "integer",
                  "format": "uint8",
                  "minimum": 0.0
                },
                "type": {
                  "type": "string",
                  "enum": [
                    "outcome"
                  ]
                }
              }
            }
          ],
          "required": [
            "exchange"
          ],
          "properties": {
            "exchange": {
              "type": "string",
              "enum": [
                "hyperliquid"
              ]
            }
          }
        }
      ]
    },
    "MarketConfig": {
      "description": "Market configuration (V2 format) — flat representation for JSON Schema.\n\nThe engine uses `bot_core::Market` (tagged enum) instead. This flat struct exists so the generated JSON Schema is clean for external consumers.",
      "type": "object",
      "required": [
        "base",
        "exchange",
        "type"
      ],
      "properties": {
        "base": {
          "description": "Base asset (e.g., \"BTC\")",
          "type": "string"
        },
        "dex": {
          "description": "DEX name (for HIP-3)",
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "exchange": {
          "description": "Exchange name (e.g., \"hyperliquid\")",
          "type": "string"
        },
        "index": {
          "description": "Market index",
          "default": null,
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0.0
        },
        "instrument_meta": {
          "description": "Instrument metadata",
          "default": null,
          "anyOf": [
            {
              "$ref": "#/definitions/InstrumentMetaConfig"
            },
            {
              "type": "null"
            }
          ]
        },
        "name": {
          "description": "Human-readable outcome name (for prediction markets)",
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "outcome_id": {
          "description": "Outcome ID from outcomeMeta (for prediction markets)",
          "default": null,
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0.0
        },
        "quote": {
          "description": "Quote asset (e.g., \"USDC\")",
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "side": {
          "description": "Outcome side: 0 = Yes, 1 = No",
          "default": null,
          "type": [
            "integer",
            "null"
          ],
          "format": "uint8",
          "minimum": 0.0
        },
        "type": {
          "description": "Market type: \"perp\", \"spot\", \"hip3\", or \"outcome\"",
          "type": "string"
        }
      }
    },
    "OrchestratorChildConfigJson": {
      "description": "Generic child strategy plan owned by the orchestrator.",
      "oneOf": [
        {
          "description": "Grid child strategy plan.",
          "type": "object",
          "required": [
            "grid",
            "kind",
            "market"
          ],
          "properties": {
            "grid": {
              "description": "Grid configuration for this child.",
              "allOf": [
                {
                  "$ref": "#/definitions/GridConfigJson"
                }
              ]
            },
            "id": {
              "description": "Optional stable child ID used in logs and strategy IDs.",
              "default": null,
              "type": [
                "string",
                "null"
              ]
            },
            "kind": {
              "type": "string",
              "enum": [
                "grid"
              ]
            },
            "market": {
              "description": "Market this child trades.",
              "allOf": [
                {
                  "$ref": "#/definitions/Market"
                }
              ]
            }
          }
        },
        {
          "description": "DCA child strategy plan.",
          "type": "object",
          "required": [
            "dca",
            "kind",
            "market"
          ],
          "properties": {
            "dca": {
              "description": "DCA configuration for this child.",
              "allOf": [
                {
                  "$ref": "#/definitions/DCAConfigJson"
                }
              ]
            },
            "id": {
              "description": "Optional stable child ID used in logs and strategy IDs.",
              "default": null,
              "type": [
                "string",
                "null"
              ]
            },
            "kind": {
              "type": "string",
              "enum": [
                "dca"
              ]
            },
            "market": {
              "description": "Market this child trades.",
              "allOf": [
                {
                  "$ref": "#/definitions/Market"
                }
              ]
            }
          }
        }
      ]
    },
    "OrchestratorCondition": {
      "description": "Deterministic condition evaluated by the orchestrator from local engine state.",
      "oneOf": [
        {
          "description": "Passes when the selected instrument mid price is above `price`.",
          "type": "object",
          "required": [
