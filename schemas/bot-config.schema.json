{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "BotConfig",
  "description": "V2 Bot configuration - the full config format for all strategies.\n\nThis is the **schema-generation** version of BotConfig. It uses flat `MarketConfig` structs (for clean JSON Schema output), unlike the engine's `BotConfig` which uses typed `bot_core::Market` enums for runtime parsing.",
  "type": "object",
  "required": [
    "address",
    "environment",
    "private_key",
    "strategy_type"
  ],
  "properties": {
    "address": {
      "description": "Wallet address",
      "type": "string"
    },
    "arbitrage": {
      "description": "Arbitrage strategy configuration",
      "default": null,
      "anyOf": [
        {
          "$ref": "#/definitions/ArbitrageConfigJson"
        },
        {
          "type": "null"
        }
      ]
    },
    "base_url_override": {
      "description": "Optional Hyperliquid base URL override. When set, both /info and /exchange requests use this gateway.",
      "default": null,
      "type": [
        "string",
        "null"
      ]
    },
    "builder_fee": {
      "description": "Builder fee configuration",
      "default": null,
      "anyOf": [
        {
          "$ref": "#/definitions/BuilderFeeConfig"
        },
        {
          "type": "null"
        }
      ]
    },
    "dca": {
      "description": "DCA strategy configuration",
      "default": null,
      "anyOf": [
        {
          "$ref": "#/definitions/DCAConfigJson"
        },
        {
          "type": "null"
        }
      ]
    },
    "environment": {
      "description": "Environment: \"testnet\" or \"mainnet\"",
      "type": "string"
    },
    "grid": {
      "description": "Grid strategy configuration",
      "default": null,
      "anyOf": [
        {
          "$ref": "#/definitions/GridConfigJson"
        },
        {
          "type": "null"
        }
      ]
    },
    "hip3": {
      "description": "HIP-3 configuration",
      "default": null,
      "anyOf": [
        {
          "$ref": "#/definitions/Hip3ConfigJson"
        },
        {
          "type": "null"
        }
      ]
    },
    "markets": {
      "description": "Markets to trade on (V2 format)",
      "default": [],
      "type": "array",
      "items": {
        "$ref": "#/definitions/MarketConfig"
      }
    },
    "mm": {
      "description": "Market Maker strategy configuration",
      "default": null,
      "anyOf": [
        {
          "$ref": "#/definitions/MMConfigJson"
        },
        {
          "type": "null"
        }
      ]
    },
    "orchestrator": {
      "description": "Orchestrator strategy configuration",
      "default": null,
      "anyOf": [
        {
          "$ref": "#/definitions/OrchestratorConfigJson"
        },
        {
          "type": "null"
        }
      ]
    },
    "poll_delay_ms": {
      "description": "Polling delay in milliseconds",
      "default": 500,
      "type": "integer",
      "format": "uint64",
      "minimum": 0.0
    },
    "private_key": {
      "description": "Private key (hex, with or without 0x prefix)",
      "type": "string"
    },
    "strategy_type": {
      "description": "Strategy type: \"grid\", \"mm\", \"dca\", \"arbitrage\", or \"orchestrator\"",
      "type": "string"
    },
    "sync": {
      "description": "Trade sync configuration",
      "default": null,
      "anyOf": [
        {
          "$ref": "#/definitions/SyncConfigJson"
        },
        {
          "type": "null"
        }
      ]
    },
    "vault_address": {
      "description": "Optional vault address",
      "default": null,
      "type": [
        "string",
        "null"
      ]
    }
  },
  "definitions": {
    "ArbitrageConfigJson": {
      "description": "Arbitrage strategy configuration from JSON",
      "type": "object",
      "required": [
        "min_closing_spread_pct",
        "min_opening_spread_pct",
        "order_amount",
        "perp_leverage"
      ],
      "properties": {
        "min_closing_spread_pct": {
          "description": "Minimum spread to close (e.g., \"-0.001\" = -0.1%)",
          "type": "string"
        },
        "min_opening_spread_pct": {
          "description": "Minimum spread to open (e.g., \"0.003\" = 0.3%)",
          "type": "string"
        },
        "order_amount": {
          "description": "Order amount in quote asset / USDC (e.g., \"100\" = $100 worth)",
          "type": "string"
        },
        "perp_leverage": {
          "description": "Leverage for perp position",
          "type": "string"
        },
        "perp_slippage_buffer_pct": {
          "description": "Slippage buffer for perp orders",
          "default": "0.001",
          "type": "string"
        },
        "spot_slippage_buffer_pct": {
          "description": "Slippage buffer for spot orders",
          "default": "0.001",
          "type": "string"
        }
      }
    },
    "BuilderFeeConfig": {
      "description": "Builder fee configuration for JSON config",
      "type": "object",
      "required": [
        "address",
        "fee_tenths_bp"
      ],
      "properties": {
        "address": {
          "description": "Builder address to receive the fee",
          "type": "string"
        },
        "fee_tenths_bp": {
          "description": "Fee in tenths of a basis point (e.g., 30 = 3 bp = 0.03%)",
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        }
      }
    },
    "DCAConfigJson": {
      "description": "DCA strategy configuration from JSON",
      "type": "object",
      "required": [
        "base_order_size",
        "dca_order_size",
        "price_deviation_pct",
        "take_profit_pct",
        "trigger_price"
      ],
      "properties": {
        "base_order_size": {
          "description": "Base order size in base asset",
          "type": "string"
        },
        "cooldown_period_secs": {
          "description": "Cooldown period in seconds between cycles (default: 60)",
          "default": 60,
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "dca_order_size": {
          "description": "DCA order size in base asset",
          "type": "string"
        },
        "deviation_multiplier": {
          "description": "Deviation multiplier for subsequent triggers",
          "default": "1.0",
          "type": "string"
        },
        "direction": {
          "description": "Direction: \"long\" or \"short\"",
          "default": "long",
          "type": "string"
        },
        "leverage": {
          "description": "Leverage (1 for spot-like)",
          "default": "5",
          "type": "string"
        },
        "max_dca_orders": {
          "description": "Maximum number of DCA orders",
          "default": 5,
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        },
        "max_leverage": {
          "description": "Max leverage allowed",
          "default": "50",
          "type": "string"
        },
        "price_deviation_pct": {
          "description": "Price deviation percentage to trigger first DCA",
          "type": "string"
        },
        "restart_on_complete": {
          "description": "Whether to restart cycle after take profit",
          "default": false,
          "type": "boolean"
        },
        "size_multiplier": {
          "description": "Size multiplier for each subsequent DCA order",
          "default": "2.0",
          "type": "string"
        },
        "stop_loss": {
          "description": "Optional stop loss as absolute PnL threshold (negative value)",
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "take_profit_pct": {
          "description": "Take profit percentage from average entry",
          "type": "string"
        },
        "trigger_price": {
          "description": "Price to trigger base order",
          "type": "string"
        }
      }
    },
    "GridConfigJson": {
      "description": "Grid strategy configuration from JSON",
      "type": "object",
      "required": [
        "end_price",
        "max_investment_quote",
        "start_price"
      ],
      "properties": {
        "end_price": {
          "description": "End price of the grid",
          "type": "string"
        },
        "levels": {
          "description": "Number of grid levels",
          "default": 20,
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        },
        "leverage": {
          "description": "Leverage to use",
          "default": "5",
          "type": "string"
        },
        "max_investment_quote": {
          "description": "Maximum investment in quote currency (USDC)",
          "type": "string"
        },
        "max_leverage": {
          "description": "Maximum leverage allowed (for liquidation calculation)",
          "default": "50",
          "type": "string"
        },
        "mode": {
          "description": "Grid mode: \"long\", \"short\", \"neutral\"",
          "default": "long",
          "type": "string"
        },
        "post_only": {
          "description": "Use post-only orders",
          "default": false,
          "type": "boolean"
        },
        "start_price": {
          "description": "Start price of the grid",
          "type": "string"
        },
        "stop_loss": {
          "description": "Stop loss (optional)",
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "take_profit": {
          "description": "Take profit (optional)",
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "trailing_down_limit": {
          "description": "Trailing lower limit price (optional). When set, enables trailing-down: the grid slides down as price falls, until the bottom of the window would go below this floor.",
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "trailing_up_limit": {
          "description": "Trailing upper limit price (optional). When set, enables trailing-up: the grid slides up as price rises, until the top of the window would exceed this ceiling.",
          "default": null,
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "Hip3ConfigJson": {
      "description": "HIP-3 configuration",
      "type": "object",
      "required": [
        "dex_index",
        "dex_name"
      ],
      "properties": {
        "asset_index": {
          "description": "Asset index within the DEX",
          "default": 0,
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        },
        "dex_index": {
          "description": "The index of the DEX",
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        },
        "dex_name": {
          "description": "The HIP-3 DEX name",
          "type": "string"
        },
        "quote_currency": {
          "description": "Quote currency: \"USDC\" or \"USDH\"",
          "default": "USDC",
          "type": "string"
        }
      }
    },
    "InstrumentMetaConfig": {
      "description": "Instrument metadata configuration",
      "type": "object",
      "required": [
        "lot_size",
        "tick_size"
      ],
      "properties": {
        "lot_size": {
          "description": "Lot size (quantity precision)",
          "type": "string"
        },
        "min_notional": {
          "description": "Minimum notional value",
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "min_qty": {
          "description": "Minimum order quantity",
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "tick_size": {
          "description": "Tick size (price precision)",
          "type": "string"
        }
      }
    },
    "MMConfigJson": {
      "description": "Market Maker strategy configuration",
      "type": "object",
      "required": [
        "base_order_size",
        "base_spread",
        "max_position_size"
      ],
      "properties": {
        "base_order_size": {
          "description": "Base order size in base asset",
          "type": "string"
        },
        "base_spread": {
          "description": "Base spread between bid and ask",
          "type": "string"
        },
        "max_position_size": {
          "description": "Maximum position size in base asset",
          "type": "string"
        },
        "min_price_change_pct": {
          "description": "Minimum price change to update quotes",
          "default": "0.0005",
          "type": "string"
        },
        "price_skew_gamma": {
          "description": "Price skew gamma (how aggressively to skew quotes based on position)",
          "default": "0.05",
          "type": "string"
        },
        "size_skew_floor": {
          "description": "Size skew floor (minimum size for quotes)",
          "default": "0.2",
          "type": "string"
        },
        "skew_mode": {
          "description": "Skew mode: \"both\", \"size\", \"price\", or \"none\"",
          "default": "both",
          "type": "string"
        },
        "stop_loss": {
          "description": "Stop loss (optional)",
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "take_profit": {
          "description": "Take profit (optional)",
          "default": null,
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "MarketConfig": {
      "description": "Market configuration (V2 format) — flat representation for JSON Schema.\n\nThe engine uses `bot_core::Market` (tagged enum) instead. This flat struct exists so the generated JSON Schema is clean for external consumers.",
      "type": "object",
      "required": [
        "base",
        "exchange",
        "type"
      ],
      "properties": {
        "base": {
          "description": "Base asset (e.g., \"BTC\")",
          "type": "string"
        },
        "dex": {
          "description": "DEX name (for HIP-3)",
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "exchange": {
          "description": "Exchange name (e.g., \"hyperliquid\")",
          "type": "string"
        },
        "index": {
          "description": "Market index",
          "default": null,
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0.0
        },
        "instrument_meta": {
          "description": "Instrument metadata",
          "default": null,
          "anyOf": [
            {
              "$ref": "#/definitions/InstrumentMetaConfig"
            },
            {
              "type": "null"
            }
          ]
        },
        "name": {
          "description": "Human-readable outcome name (for prediction markets)",
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "outcome_id": {
          "description": "Outcome ID from outcomeMeta (for prediction markets)",
          "default": null,
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0.0
        },
        "quote": {
          "description": "Quote asset (e.g., \"USDC\")",
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "side": {
          "description": "Outcome side: 0 = Yes, 1 = No",
          "default": null,
          "type": [
            "integer",
            "null"
          ],
          "format": "uint8",
          "minimum": 0.0
        },
        "type": {
          "description": "Market type: \"perp\", \"spot\", \"hip3\", or \"outcome\"",
          "type": "string"
        }
      }
    },
    "OrchestratorConfigJson": {
      "description": "Parent strategy configuration for grouped child strategies.",
      "type": "object",
      "properties": {
        "allocation_mode": {
          "description": "Static allocation mode for child legs. V1 supports \"static_50_50\".",
          "default": "static_50_50",
          "type": "string"
        },
        "kind": {
          "description": "V1 kind: \"prediction_yes_no_grid\"",
          "default": "prediction_yes_no_grid",
          "type": "string"
        },
        "legs": {
          "description": "Explicit child-leg ranges supplied by the client from live prices.",
          "default": [],
          "type": "array",
          "items": {
            "$ref": "#/definitions/OrchestratorLegConfigJson"
          }
        },
        "stop_loss_pct": {
          "description": "Group stop-loss threshold in percentage units. Example: \"5\" = -5%.",
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "take_profit_pct": {
          "description": "Group take-profit threshold in percentage units. Example: \"10\" = +10%.",
          "default": null,
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "OrchestratorLegConfigJson": {
      "description": "Per-leg range override for orchestrated child strategies.",
      "type": "object",
      "required": [
        "end_price",
        "side",
        "start_price"
      ],
      "properties": {
        "end_price": {
          "description": "Child grid end price for this side.",
          "type": "string"
        },
        "side": {
          "description": "Outcome side: 0 = Yes, 1 = No",
          "type": "integer",
          "format": "uint8",
          "minimum": 0.0
        },
        "start_price": {
          "description": "Child grid start price for this side.",
          "type": "string"
        },
        "trailing_down_limit": {
          "description": "Optional child trailing floor for this side.",
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "trailing_up_limit": {
          "description": "Optional child trailing ceiling for this side.",
          "default": null,
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "SyncConfigJson": {
      "description": "Trade syncer configuration for upstream API PnL tracking",
      "type": "object",
      "required": [
        "bot_id",
        "upstream_url"
      ],
      "properties": {
        "bot_id": {
          "description": "Bot ID for upstream API (required if enabled)",
          "type": "string"
        },
        "enabled": {
          "description": "Enable syncing (default: true if sync section is present)",
          "default": true,
          "type": "boolean"
        },
        "sync_interval_ms": {
          "description": "Sync interval in milliseconds (default: 10000)",
          "default": 10000,
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "sync_secret": {
          "description": "Optional shared secret sent as x-bot-sync-secret.",
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "timeout_secs": {
          "description": "HTTP timeout in seconds (default: 10)",
          "default": 10,
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "upstream_url": {
          "description": "Upstream API base URL (e.g., \"https://api.example.com/bot-api\")",
          "type": "string"
        }
      }
    }
  }
}